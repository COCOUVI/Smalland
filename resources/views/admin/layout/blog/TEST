    <script>
        // Define data at the beginning
        const categories = [
            { "id": 1, "name": "Technologie" },
            { "id": 2, "name": "Design" },
            { "id": 3, "name": "Développement" },
            { "id": 4, "name": "Marketing" },
            { "id": 5, "name": "Actualités" }
        ];

        const publicationData = {
            "titre": "",
            "content": "",
            "image_path": "",
            "pub_category_id": "",
            "author": "",
            "tags": "",
            "status": "Draft"
        };

        // DOM Elements
        const successMessage = document.getElementById('successMessage');
        const successText = document.getElementById('successText');
        const errorMessage = document.getElementById('errorMessage');
        const errorList = document.getElementById('errorList');
        const pageTitle = document.getElementById('pageTitle');
        const submitButtonText = document.getElementById('submitButtonText');
        const currentImage = document.getElementById('currentImage');
        const imagePreview = document.getElementById('imagePreview');

        // Initialize form
        function initializeForm() {
            populateCategories();
            setupEventListeners();
            checkForEditMode();
        }

        // Populate categories dropdown
        function populateCategories() {
            const categorySelect = document.getElementById('pub_category_id');
            categories.forEach(cat => {
                const option = document.createElement('option');
                option.value = cat.id;
                option.textContent = cat.name;
                categorySelect.appendChild(option);
            });
        }

        // Setup event listeners
        function setupEventListeners() {
            const form = document.getElementById('publicationForm');
            const fileInput = document.getElementById('image');

            form.addEventListener('submit', handleFormSubmit);
            fileInput.addEventListener('change', handleImageUpload);
        }

        // Check if we're in edit mode
        function checkForEditMode() {
            // Simulate edit mode detection
            const urlParams = new URLSearchParams(window.location.search);
            const editMode = urlParams.get('edit');

            if (editMode) {
                pageTitle.textContent = "Modifier la publication";
                submitButtonText.textContent = "Mettre à jour";
                
                // Simulate existing publication data
                publicationData.titre = "Titre de la publication existante";
                publicationData.content = "Contenu de la publication existante...";
                publicationData.pub_category_id = "2";
                publicationData.author = "Jean Dupont";
                publicationData.tags = "technologie, design";
                publicationData.status = "Publish";
                publicationData.image_path = "https://picsum.photos/300/200?random=1";
                
                populateFormWithData();
            }
        }

        // Populate form with existing data
        function populateFormWithData() {
            document.getElementById('titre').value = publicationData.titre;
            document.getElementById('content').value = publicationData.content;
            document.getElementById('pub_category_id').value = publicationData.pub_category_id;
            document.getElementById('author').value = publicationData.author;
            document.getElementById('tags').value = publicationData.tags;
            document.getElementById('status').value = publicationData.status;

            if (publicationData.image_path) {
                imagePreview.src = publicationData.image_path;
                imagePreview.alt = "Image actuelle de la publication";
                currentImage.classList.remove('hidden');
            }
        }

        // Handle form submission
        function handleFormSubmit(e) {
            e.preventDefault();
            
            const formData = new FormData(e.target);
            const errors = validateForm(formData);

            if (errors.length > 0) {
                showErrors(errors);
            } else {
                submitForm(formData);
            }
        }

        // Validate form data
        function validateForm(formData) {
            const errors = [];

            if (!formData.get('titre')?.trim()) {
                errors.push("Le titre est requis");
            }

            if (!formData.get('content')?.trim()) {
                errors.push("Le contenu est requis");
            }

            if (!formData.get('pub_category_id')) {
                errors.push("La catégorie est requise");
            }

            if (!formData.get('author')?.trim()) {
                errors.push("L'auteur est requis");
            }

            return errors;
        }

        // Handle image upload
        function handleImageUpload(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(event) {
                    imagePreview.src = event.target.result;
                    currentImage.classList.remove('hidden');
                };
                reader.readAsDataURL(file);
            }
        }

        // Show error messages
        function showErrors(errors) {
            errorList.innerHTML = '';
            errors.forEach(error => {
                const li = document.createElement('li');
                li.textContent = error;
                errorList.appendChild(li);
            });
            errorMessage.classList.remove('hidden');
            successMessage.classList.add('hidden');
        }

        // Show success message
        function showSuccess(message) {
            successText.textContent = message;
            successMessage.classList.remove('hidden');
            errorMessage.classList.add('hidden');
        }

        // Submit form (simulated)
        function submitForm(formData) {
            // Simulate API call
            setTimeout(() => {
                showSuccess("Publication créée avec succès!");
                // Reset form if needed
                // document.getElementById('publicationForm').reset();
            }, 1000);
        }

        // Initialize the form when DOM is loaded
        document.addEventListener('DOMContentLoaded', initializeForm);

        // Handle navigation for all anchor tags
        document.addEventListener('DOMContentLoaded', function() {
            const anchors = document.querySelectorAll('a');
            anchors.forEach(anchor => {
                anchor.addEventListener('click', function(e) {
                    e.preventDefault();
                    // Simulate navigation
                    console.log("Navigation vers:", this.href);
            });
        });
    </script>
</body>
</html>
